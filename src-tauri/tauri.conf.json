{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plazma S PC",
  "version": "0.1.0",
  "identifier": "com.plazmas.pc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plazma S PC",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Private PC-to-PC transfers",
    "longDescription": "Secure, direct file transfers between Windows computers on your local network.",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/trojanhorse-star/PSpc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}